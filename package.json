{
  "name": "deckseed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first Markdown presentation generator for self-contained Pandoc and Reveal.js slide decks.",
  "keywords": ["markdown-presentation-generator", "presentation-as-code", "ai-agents", "slides", "pandoc", "reveal.js", "offline-html", "agent-skill"],
  "pi": {
    "skills": ["./.agents/skills"]
  },
  "scripts": {
    "new": "node scripts/new-deck.mjs",
    "build": "node scripts/build-deck.mjs",
    "bundle": "node scripts/build-deck.mjs",
    "serve": "node scripts/serve.mjs",
    "open": "node scripts/open.mjs",
    "themes:previews": "node scripts/generate-theme-previews.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
